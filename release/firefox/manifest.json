{"manifest_version":3,"name":"Sukoon — Calm the Web","description":"Calms motion, flashing and hijacked scrolling on any website. Open source, fully local, no servers.","version":"0.4.0","short_name":"Sukoon","icons":{"16":"icon/16.png","32":"icon/32.png","48":"icon/48.png","128":"icon/128.png"},"permissions":["storage","scripting","activeTab","contextMenus","browserSettings"],"host_permissions":["<all_urls>"],"commands":{"panic":{"suggested_key":{"default":"Alt+Shift+S"},"description":"Freeze the page instantly (press again to release)"},"toggle":{"suggested_key":{"default":"Alt+Shift+P"},"description":"Turn Sukoon off / on everywhere"}},"action":{"default_title":"Sukoon","default_icon":{"16":"icon/16.png","32":"icon/32.png","48":"icon/48.png","128":"icon/128.png"},"default_popup":"popup.html"},"browser_specific_settings":{"gecko":{"id":"sukoon@sukoon.dev","strict_min_version":"140.0","data_collection_permissions":{"required":["none"]}}},"background":{"scripts":["background.js"]},"options_ui":{"open_in_tab":true,"page":"options.html"}}